{
  "name": "workout-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:auth": "cdk deploy WorkoutAuthStack",
    "deploy:api": "cdk deploy WorkoutApiStack",
    "deploy:all": "cdk deploy --all",
    "diff": "cdk diff",
    "destroy": "cdk destroy --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node --prefer-ts-exts src/db/seed.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "22.x",
    "aws-cdk": "2.x",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.30.0",
    "ts-node": "^10.9.2",
    "typescript": "5.x"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1107.0",
    "@aws-sdk/client-sqs": "^3.1107.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@neondatabase/serverless": "^0.10.0",
    "aws-cdk-lib": "2.x",
    "constructs": "^10.0.0",
    "drizzle-orm": "^0.40.0",
    "source-map-support": "^0.5.21"
  }
}
